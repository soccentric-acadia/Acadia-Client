[Unit]
Description=Acadia Client — gRPC daemon for IV&V hardware validation
Documentation=https://github.com/SiliconCentric/Acadia-Client
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=acadia
Group=acadia
WorkingDirectory=/var/lib/acadia
# Starts BOTH listeners:
#   - ClientService (stream path → Server, default port 50051)
#   - HalService    (SDK/E2E path,          default port 50052)
ExecStart=/usr/bin/acadia-client
Restart=on-failure
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=acadia-client

# Hardening
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ReadWritePaths=/var/lib/acadia
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# VB-1: the embedded HAL needs to reach real hardware. Kept in sync with the
# shipped meta-acadia copy of this unit — see that repo's task 010 for why
# these groups/caps and not setuid/setcap.
SupplementaryGroups=i2c spi gpio dialout video audio disk
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYSLOG
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYSLOG

[Install]
WantedBy=multi-user.target
